# Copy to .env at the repo root (never commit .env).
# MongoDB connection string for the product catalog.
MONGO_URI_CONNECTION_STRING=mongodb://localhost:27017/shelflife
# OpenAI API key for the expiration judge (gpt-4o-mini).
OPENAI_KEY=
# Google Places API key for the nearby pantry search.
VITE_GOOGLE_API_KEY=
# Auth0: the client ID, issuer, and secret are currently hardcoded in
# backend/index.js. Before wiring them to env vars here, rotate the secret
# in the Auth0 dashboard — the value in the repo must be treated as leaked.
# AUTH0_SECRET=
# AUTH0_CLIENT_ID=
# AUTH0_ISSUER_BASE_URL=
